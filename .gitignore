# Repo-wide safety net. Each project folder keeps its own .gitignore too.

# --- secrets: never commit ---
.env
.env.*
!.env.example
*.key
*.pem
credentials.json
secrets.json

# --- agent logs (AGENTS.md S2: never commit) ---
log.txt

# --- python / os / editor ---
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
.DS_Store
Thumbs.db
.idea/
.vscode/
